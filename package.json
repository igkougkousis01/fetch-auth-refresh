{
  "name": "fetch-auth-refresh",
  "version": "0.0.0",
  "description": "A tiny, dependency-free fetch wrapper that adds concurrency-safe (single-flight) authentication token refresh.",
  "keywords": [
    "fetch",
    "auth",
    "authentication",
    "token",
    "refresh",
    "single-flight",
    "401",
    "typescript"
  ],
  "license": "MIT",
  "author": "igkougkousis01",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/igkougkousis01/fetch-auth-refresh.git"
  },
  "bugs": {
    "url": "https://github.com/igkougkousis01/fetch-auth-refresh/issues"
  },
  "homepage": "https://github.com/igkougkousis01/fetch-auth-refresh#readme",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "npm run clean && tsc -p tsconfig.build.json",
    "clean": "node -e \"fs.rmSync(process.argv[1],{recursive:true,force:true})\" dist",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run typecheck && npm run test && npm run build"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  },
  "publishConfig": {
    "access": "public"
  }
}
