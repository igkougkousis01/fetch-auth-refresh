{
  "name": "fetch-auth-refresh",
  "version": "0.1.0",
  "description": "A zero-runtime-dependency authentication wrapper for native fetch with concurrency-safe single-flight token refresh.",
  "keywords": [
    "fetch",
    "auth",
    "authentication",
    "authorization",
    "token",
    "refresh",
    "access-token",
    "bearer",
    "single-flight",
    "401",
    "esm",
    "typescript"
  ],
  "license": "MIT",
  "author": {
    "name": "igkougkousis01",
    "url": "https://github.com/igkougkousis01"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/igkougkousis01/fetch-auth-refresh.git"
  },
  "bugs": {
    "url": "https://github.com/igkougkousis01/fetch-auth-refresh/issues"
  },
  "homepage": "https://github.com/igkougkousis01/fetch-auth-refresh#readme",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "src",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "npm run clean && tsc -p tsconfig.build.json",
    "clean": "node -e \"fs.rmSync(process.argv[1],{recursive:true,force:true})\" dist",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify": "npm run typecheck && npm test && npm run build",
    "prepack": "npm run build",
    "prepublishOnly": "npm run typecheck && npm test"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  },
  "publishConfig": {
    "access": "public"
  }
}
